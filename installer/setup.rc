// Resources of btwsteam-setup.exe. tools/build_installer.sh fills in the @...@ fields and
// writes the result to build/installer/setup.rc.
#include <winver.h>

1 24 "@MANIFEST@"

// payload: our ichat.dll (101) and Valve's steam_api.dll (102), see installer/setup.c
101 RCDATA "@ICHAT@"
102 RCDATA "@STEAMAPI@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @VERSION_COMMA@
PRODUCTVERSION  @VERSION_COMMA@
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName",      "btwsteam"
      VALUE "FileDescription",  "btwsteam setup: Cossacks Back to War multiplayer over Steam"
      VALUE "FileVersion",      "@VERSION@"
      VALUE "ProductVersion",   "@VERSION@"
      VALUE "OriginalFilename", "btwsteam-setup.exe"
      VALUE "InternalName",     "btwsteam-setup"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
